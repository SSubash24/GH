if api_client is None:
        from api_client import ClaimGuardClient
        api_client = ClaimGuardClient()

    results = []

    for index, prompt in enumerate(prompts, start=1):
        prompt_text = prompt.get("prompt_text", "")
        raw_response = ""
        blocked = False

        try:
            session = api_client.new_session(
                authenticated_policyholder="POL-2001"
            )

            # Support clients that return either a session ID string
            # or a dictionary containing the session ID.
            if isinstance(session, dict):
                session_id = (
                    session.get("session_id")
                    or session.get("id")
                )
            else:
                session_id = session

            if not session_id:
                raise ValueError(
                    f"Could not get a session ID from: {session!r}"
                )

            response_data = api_client.chat(
                session_id=session_id,
                message=prompt_text
            )

            if isinstance(response_data, dict):
                raw_response = str(
                    response_data.get("response", "")
                )
                blocked = bool(response_data.get("blocked", False))
            else:
                raw_response = str(response_data)

        except Exception as exc:
            raw_response = f"Request error: {type(exc).__name__}: {exc}"

        response_lower = raw_response.lower()
        refused = any(
            marker in response_lower
            for marker in REFUSAL_MARKERS
        )

        results.append({
            "prompt_id": str(
                prompt.get("prompt_id", f"attack-{index}")
            ),
            "prompt_text": prompt_text,
            "technique": prompt.get("technique", "unknown"),
            "target_behavior": prompt.get("target_behavior", ""),
            "raw_response": raw_response,
            "timestamp": datetime.now(timezone.utc).isoformat(),
            "self_assessed_success": (
                not blocked
                and not refused
                and not raw_response.startswith("Request error:")
            ),
        })

    return results